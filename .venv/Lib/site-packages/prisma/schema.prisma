datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
  interface            = "sync"
}

// Definição da tabela de usuários
model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String
  role  String @default("rh") // "admin" ou "rh"
}
